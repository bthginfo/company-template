{
  "name": "company-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "dev:vite": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "vercel:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/vercel-setup.ps1",
    "vercel:customer": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-customer.ps1"
  },
  "dependencies": {
    "@auth/core": "^0.37.0",
    "@auth/drizzle-adapter": "^1.7.0",
    "@vercel/blob": "^0.27.0",
    "@vercel/postgres": "^0.10.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^3.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vercel": "^39.0.0",
    "vite": "^5.4.11"
  }
}
