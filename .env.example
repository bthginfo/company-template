# Postgres (Vercel Postgres dashboard → Quickstart .env.local)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Auth.js
AUTH_SECRET=                       # openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Resend (magic-link emails)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=login@example.com

# Per-deployment tenant identifier (set in Vercel project env vars)
VITE_TENANT_SLUG=demo
VITE_TEMPLATE=restaurant

# IONOS SMTP (contact form / api/contact.ts)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=hello@flamingomedia.online
SMTP_PASS=
MAIL_FROM=hello@flamingomedia.online
MAIL_TO=hello@flamingomedia.online
MAIL_AUTOREPLY=on
